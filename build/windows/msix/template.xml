<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sarif-viewer"
        Arguments=""
        InstallLocation="C:\Program Files\SARIF Viewer\SARIF Viewer">
    </Installer>
    <PackageInformation
        PackageName="app.sarif-viewer.desktop"
        PackageDisplayName="SARIF Viewer"
        PublisherName="CN=SARIF Viewer"
        PublisherDisplayName="SARIF Viewer"
        Version="0.1.0.0"
        PackageDescription="Review and annotate findings from SARIF files">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.sarif-viewer.desktop"
                Description="Review and annotate findings from SARIF files"
                DisplayName="SARIF Viewer"
                ExecutableName="sarif-viewer"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SARIF Viewer</DisplayName>
            <PublisherDisplayName>SARIF Viewer</PublisherDisplayName>
            <Description>Review and annotate findings from SARIF files</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sarif-viewer.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
